HOST=127.0.0.1
PORT=3100
PUBLIC_URL=http://localhost:3100
MAGICPATH_MCP_URL=https://api.magicpath.ai/mcp
# Supply your own high-entropy static secret (minimum 32 non-whitespace characters).
RAKAZO_SECRET_TOKEN=
# Supply a base64-encoded 32-byte encryption key; keep it stable across restarts.
TOKEN_ENCRYPTION_KEY=
TOKEN_STATE_FILE=./state/tokens.enc.json
# Obtain via provider-approved client registration. No automatic registration occurs.
MAGICPATH_CLIENT_ID=
# Only for a confidential client registered for client_secret_post; public client: leave blank.
MAGICPATH_CLIENT_SECRET=
MAGICPATH_SCOPES=magicpath:read magicpath:write
# Optional comma-separated trusted HTTPS origins if provider metadata changes. Never accept arbitrary discovery origins.
OAUTH_TRUSTED_ORIGINS=
# Required for Docker browser setup; optional extra Basic authentication for native setup.
# Use a distinct high-entropy secret. Browser username can be 'admin'.
ADMIN_SECRET_TOKEN=
# Optional reachable origin for Rakazo (not OAuth callback): e.g. http://host.docker.internal:3100.
# This also adds its Host header to the explicit allowlist. Leave blank for PUBLIC_URL.
RAKAZO_PROXY_URL=
