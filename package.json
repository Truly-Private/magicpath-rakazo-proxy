    "check": "tsc --noEmit",
    "config": "node dist/index.js --config"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/swagger-ui-express": "4.1.8",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "license": "UNLICENSED"
}
